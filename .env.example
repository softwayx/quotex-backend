NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (or any replica set — transactions need one). Put the database name in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/riskquo?retryWrites=true&w=majority

# Public address of the website (Next app): referral links and the Razorpay webhook URL.
SITE_URL=http://localhost:3000

# 32+ char random secrets (openssl rand -hex 32). Reuse the old app's values to keep users signed in.
USER_SESSION_SECRET=
ADMIN_SESSION_SECRET=

# 64 hex characters (openssl rand -hex 32). Encrypts payment/email secrets and WhatsApp keys.
# MUST be the old app's value if you migrate data, or saved secrets cannot be decrypted. Back it up.
APP_ENCRYPTION_KEY=

# Reconnect saved WhatsApp numbers when the API starts.
WHATSAPP_ENABLED=true

# Used by `npm run seed:admin`
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=

# Blog: after a post is published/edited/deleted the API calls ${SITE_URL}/api/revalidate?secret=...
# Same value as REVALIDATE_SECRET on the website (Vercel). 32+ random characters. Empty = skip.
REVALIDATE_SECRET=

# Cloudinary (blog cover + inline images). Dashboard -> Settings -> API Keys. Uploads answer 503 until set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=riskquo/blog
